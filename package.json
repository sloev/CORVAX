{
  "name": "corvax",
  "version": "1.0.0",
  "description": "CORVAX: find any peer by its key and open a WebRTC DataChannel to it. Universal discovery and signalling, zero dependencies.",
  "type": "module",
  "exports": {
    ".": {
      "browser": "./dist/corvax.min.js",
      "default": "./src/index.js"
    },
    "./min": "./dist/corvax.min.js",
    "./anchor": "./src/anchor.js"
  },
  "bin": {
    "corvax": "bin/corvax.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "assets/logo/favicon.ico"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=esm --platform=neutral --legal-comments=none --outfile=dist/corvax.min.js --banner:js=\"/*! CORVAX v${CORVAX_VERSION:-$npm_package_version} | MIT | github.com/sloev/corvax */\"",
    "test": "node --test --test-concurrency=1 --test-force-exit test/*.test.js"
  },
  "license": "MIT",
  "optionalDependencies": {
    "werift": "^0.27.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "node-datachannel": "^0.33.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sloev/corvax.git"
  },
  "homepage": "https://corvax.sloev.workers.dev/",
  "keywords": [
    "p2p",
    "webrtc",
    "signalling",
    "dht",
    "discovery",
    "peer-to-peer"
  ],
  "publishConfig": {
    "access": "public"
  }
}
